<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.FitTracker" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        <item name="colorSecondary">@color/heart_color</item>
        <item name="colorSecondaryContainer">@color/primary_light</item>
        <item name="colorOnSecondaryContainer">@color/primary_dark</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="android:colorBackground">@color/app_bg</item>
        <item name="android:statusBarColor">@color/app_bg</item>
        <item name="android:navigationBarColor">@color/card_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="FitCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Small coloured metric tile -->
    <style name="StatTile" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="HeroBox">
        <item name="android:background">@drawable/bg_hero</item>
        <item name="android:elevation">6dp</item>
    </style>

    <style name="ScreenTitle">
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="CardTitle">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="SubText">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="OverLine">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="StatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="StatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="StatColumn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="HeroValue" parent="StatValue">
        <item name="android:textColor">@color/text_on_hero</item>
    </style>

    <style name="HeroLabel" parent="StatLabel">
        <item name="android:textColor">@color/text_on_hero_dim</item>
    </style>

    <style name="TileEmoji">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/bg_circle_white</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_light</item>
    </style>
</resources>
